diff --git a/src/components/CallFooter.module.css b/src/components/CallFooter.module.css
index 01c1ac9..d067762 100644
--- a/src/components/CallFooter.module.css
+++ b/src/components/CallFooter.module.css
@@ -162,3 +162,30 @@ Once we exceed 500 we hide everything except the buttons.
     gap: var(--cpd-space-4x);
   }
 }
+
+/*
+ElementCtrl: the call's buttons sit in a floating frosted-glass island, the same
+look as ElementCtrl's message box and tab bar: whatever is behind it is blurred and
+tinted, with a light rim along the top edge and a soft shadow so it floats.
+*/
+.buttons {
+  align-items: center;
+  padding: var(--cpd-space-2x) var(--cpd-space-3x);
+  border-radius: 999px;
+  background: rgba(27, 30, 36, 0.62);
+  -webkit-backdrop-filter: blur(26px) saturate(1.3);
+  backdrop-filter: blur(26px) saturate(1.3);
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.14),
+    0 10px 30px rgba(0, 0, 0, 0.38);
+}
+
+/* The island already gives the buttons their space: keep the bar off the screen edge without extra height
+   (not in picture-in-picture, which has its own spacing above). */
+@container element-call (min-height: 401px) {
+  .footer {
+    padding-block: var(--cpd-space-4x)
+      calc(env(safe-area-inset-bottom) + var(--cpd-space-5x));
+  }
+}
