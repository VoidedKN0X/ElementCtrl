<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ctrl / Signal dark, used while the device is in dark mode: #08080A window, light bar icons. -->
    <style name="Theme.ElementCtrl" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#08080A</item>
        <item name="android:colorBackground">#08080A</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:colorAccent">#B48CFF</item>
    </style>
</resources>
